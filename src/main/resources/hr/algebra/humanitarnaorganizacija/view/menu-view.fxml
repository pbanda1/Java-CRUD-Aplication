<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="rootAnchorPane" prefHeight="25.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.humanitarnaorganizacija.controller.MenuController">
    <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <menus>
            <Menu text="Data">
                <items>
                    <MenuItem text="Starting page" onAction="#onStartingPage"/>
                    <MenuItem text="Tables" onAction="#onTables"/>
                    <MenuItem fx:id="loadStatesMenuItem" text="Load States API" onAction="#onLoadStates"/>
                    <MenuItem fx:id="loadOrganisationsXMLMenuItem" text="Load Organisations from XML" onAction="#onLoadOrganisationsXML"/>
                    <MenuItem fx:id="exportOrganisationsXMLMenuItem" text="Export Organisations to XML" onAction="#onExportOrganisationsXML"/>
                    <MenuItem fx:id="adminMenuItem" text="Admin" onAction="#onAdmin"/>
                    <MenuItem text="Log out" onAction="#onLogout"/>
                    <MenuItem text="About" onAction="#AboutUs"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>
</AnchorPane>
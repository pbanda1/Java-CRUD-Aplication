<BorderPane fx:id="rootPane4stage" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.algebra.humanitarnaorganizacija.controller.ManageController">
    <top>
        <fx:include source="menu-view.fxml" />
    </top>
   <center>
       <GridPane hgap="10" vgap="10">
           <padding>
               <Insets bottom="20" left="20" right="20" top="20" />
           </padding>

           <Label text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
           <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

           <Label text="Establishment Year:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
           <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

           <Label text="Num of Employees:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
           <TextField fx:id="employeesField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

           <Label text="Yearly Budget:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
           <TextField fx:id="budgetField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

           <Label text="End Goal:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
           <TextField fx:id="endGoalField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

           <Label text="Logo:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
           <TextField fx:id="logoField" GridPane.columnIndex="1" GridPane.rowIndex="5" />

           <Label text="Country:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
           <ComboBox fx:id="countryComboBox" GridPane.columnIndex="1" GridPane.rowIndex="6" />

           <Label text="Mission:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
           <ComboBox fx:id="missionComboBox" GridPane.columnIndex="1" GridPane.rowIndex="7" />

           <Label text="Volunteer:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
           <ComboBox fx:id="volunteerComboBox" GridPane.columnIndex="1" GridPane.rowIndex="8" />

           <Label text="Sponsor:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
           <ComboBox fx:id="sponsorComboBox" GridPane.columnIndex="1" GridPane.rowIndex="9" />

           <Label text="Campaign:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
           <ComboBox fx:id="campaignComboBox" GridPane.columnIndex="1" GridPane.rowIndex="10" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
       </GridPane>
   </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20" left="20" right="20" top="10" />
            </padding>
            <Button fx:id="saveButton" onAction="#onSave" text="Save" />
            <Button fx:id="cancelButton" onAction="#onCancel" text="Cancel" />
        </HBox>
    </bottom>
</BorderPane>
